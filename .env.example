# isitdead needs no API keys. Every source it queries is keyless and public.
# Both variables below are optional.

# Where the on-disk HTTP cache lives (default: ~/.cache/isitdead).
# Only clean answers (2xx, 404, 410) are cached, for 6 hours.
ISITDEAD_CACHE_DIR=

# Set to any value to disable ANSI colors in terminal output.
NO_COLOR=
