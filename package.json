{
  "name": "isitdead",
  "version": "0.1.0",
  "description": "Is this company or project actually alive? Evidence-backed liveness checks from keyless public endpoints, where an error is never counted as dead.",
  "keywords": [
    "liveness",
    "due-diligence",
    "company",
    "startup",
    "dead",
    "diligence",
    "github",
    "npm",
    "cli",
    "rate-limit"
  ],
  "homepage": "https://github.com/agnij-dutta/isitdead#readme",
  "bugs": {
    "url": "https://github.com/agnij-dutta/isitdead/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/isitdead.git"
  },
  "license": "MIT",
  "author": "Agnij Dutta (https://x.com/0xholmesdev)",
  "type": "module",
  "bin": {
    "isitdead": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "demo:flaky": "node dist/cli.js demo-flaky",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
